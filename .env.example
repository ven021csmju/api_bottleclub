# ===========================================================================
# Environment configuration template for the `api` service.
#
# Copy this file to `.env` (or `cp .env.example .env`) and fill in real values.
# NEVER commit the real `.env` — it contains secrets and is gitignored.
# ===========================================================================

# Runtime environment: e.g. development | staging | production
ENVIRONMENT=development

# PostgreSQL connection string for the `database` service.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bottle_club_dev

# Redis connection string
REDIS_URL=redis://localhost:6379/0

# JWT signing secret — MUST be overridden with a long random string in .env
# Generate one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed CORS origins (JSON list of strings)
CORS_ORIGINS=["http://localhost:3000"]

# Standalone OCR Service (runs separately) HTTP endpoint + timeout (seconds)
OCR_SERVICE_URL=http://127.0.0.1:9000
OCR_SERVICE_TIMEOUT=60
