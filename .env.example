# ===========================================================================
# Environment configuration template for the `api` service.
#
# Copy this file to `.env` (or `cp .env.example .env`) and fill in real values.
# NEVER commit the real `.env` — it contains secrets and is gitignored.
# ===========================================================================

# Runtime environment: e.g. development | staging | production
ENVIRONMENT=development

# PostgreSQL connection string for the `database` service.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bottle_club_dev

# PostgreSQL test connection used by the pytest suite (tests/conftest.py).
# Set this in .env to point at your local test database. CI sets it as an
# environment variable directly; leave the default otherwise.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bottle_club_test

# Redis connection string
REDIS_URL=redis://localhost:6379/0

# JWT signing secret — MUST be overridden with a long random string in .env
# Generate one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OpenID Connect. Keep the client secret server-side only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Required only when a Google email does not already belong to a user.
GOOGLE_DEFAULT_ORGANIZATION_ID=
GOOGLE_DEFAULT_ROLE_NAME=
GOOGLE_DEFAULT_BRANCH_ID=

# Allowed CORS origins (JSON list of strings)
CORS_ORIGINS=["https://the-bottle-club-ai.vercel.app", "https://front-posimon.vercel.app", "http://localhost:3000", "http://localhost:3001", "http://localhost:5174"]

# Optional when more than one active organization exists.
REGISTRATION_ORGANIZATION_ID=

# MongoDB (log service) — reached via SSH tunnel on Windows:
#   ssh -L 27017:localhost:27017 <user>@<ubuntu-host>
# MONGODB_URI stays mongodb://localhost:27017 because the tunnel maps the
# Ubuntu server's MongoDB to localhost:27017 on the Windows machine.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=system_logs
MONGODB_CONNECTION_TIMEOUT_MS=2000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=1500
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=1
MONGODB_RETRY_COOLDOWN_SECONDS=15
# MongoDB only stores logs / search history / user activity / system events.
# Business data stays in PostgreSQL. TTL (days) auto-expires old logs:
MONGODB_USER_LOGS_TTL_DAYS=90
MONGODB_SEARCH_LOGS_TTL_DAYS=90
MONGODB_SYSTEM_EVENTS_TTL_DAYS=180

# Standalone OCR Service (runs separately) HTTP endpoint + timeout (seconds)
OCR_SERVICE_URL=http://127.0.0.1:9000
OCR_SERVICE_TIMEOUT=60

# Rate limiting (slowapi). Disable by setting RATE_LIMIT_ENABLED=false.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=30/minute
RATE_LIMIT_REFRESH=60/minute

# PostgreSQL connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# RabbitMQ user-log pipeline (Phase 4/5).
# The exchange / queue / routing keys MUST match mongo-log-service's .env so
# the User Log Worker consumes these events.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=user_logs
RABBITMQ_QUEUE=user_log_queue
RABBITMQ_ROUTING_KEY=user.log
RABBITMQ_DLQ=user_log_dlq
RABBITMQ_DLQ_ROUTING_KEY=user.log.dead
